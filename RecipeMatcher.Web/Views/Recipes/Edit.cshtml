@model EditRecipeViewModel
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>
    <label asp-for="PreparationMinutes"></label>
    <input asp-for="PreparationMinutes" />
    <span asp-validation-for="PreparationMinutes"></span>
    <h2>Ingredients</h2>
    @foreach (IngredientOptionViewModel ingredient in Model.Ingredients)
    {
        <label>
            <input type="checkbox" name="ingredientIds" value="@ingredient.Id" @(ingredient.Selected ? "checked" : "") />
            @ingredient.Name
        </label>
    }

    <button type="submit">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}