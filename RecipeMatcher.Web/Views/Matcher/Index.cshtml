@model PantryViewModel
<h1>Pantry</h1>
<form asp-action="Index" method="post">
    @foreach (IngredientOptionViewModel ingredient in Model.Ingredients)
    {
        <label>
            <input type="checkbox" name="ingredientIds" value="@ingredient.Id" @(ingredient.Selected ? "checked" : "") />
            @ingredient.Name
        </label>
    }
    <button type="submit">Find recipes</button>
</form>

@if (Model.MatchedRecipes.Count > 0)
{
    <h2>Matching recipes</h2>
    <ul>
        @foreach (MatchedRecipeViewModel recipe in Model.MatchedRecipes)
        {
            <li>
                @recipe.Name (@recipe.PreparationMinutes minutes)
                <ul>
                    @foreach (string ingredientName in recipe.IngredientNames)
                    {
                        <li>@ingredientName</li>
                    }
                </ul>
            </li>
        }
    </ul>
}
else
{
    <p>Er zijn geen recepten die dit ingredient bevatten <span
        style="border: 2px solid black; padding: 3px; background: #cfd">Kies een verborgen
        ingredient</span></p>
    }